# Firebase Configuration Template for CD-PTMS
# Copy this file to .env and replace with your real Firebase Project credentials.
# Do NOT commit .env with real secrets to version control.

VITE_FIREBASE_API_KEY=AIzaSyExampleKey1234567890
VITE_FIREBASE_AUTH_DOMAIN=community-tracker-ghana.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=community-tracker-ghana
VITE_FIREBASE_STORAGE_BUCKET=community-tracker-ghana.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Application Settings
VITE_APP_NAME="Community Development Project Tracking and Monitoring System"
VITE_APP_COUNTRY="Ghana"
